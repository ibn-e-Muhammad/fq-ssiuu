# FQ-SSIUU Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# See handbook/DRIVE_SETUP_GUIDE.md for setup instructions.

# HuggingFace access token (for gated model downloads)
HF_TOKEN=

# Kaggle credentials (for API access outside Kaggle runtime)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Google Drive artifact upload (service account JSON path or inline JSON)
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
