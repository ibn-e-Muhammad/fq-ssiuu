# FQ-SSIUU Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# See handbook/DRIVE_SETUP_GUIDE.md for setup instructions.
# On Kaggle, put these KEY=value lines in a private Secret named FQ_SSIUU_DOTENV,
# or create individual Secrets with matching names. Never attach .env as a dataset.
# Values are read on demand; an integration-only run needs no credentials.

# Optional authenticated GitHub operations. Private bundle transport needs neither.
GITHUB_TOKEN=
GIT_TOKEN=

# HuggingFace token (gated model/data downloads and private artifact uploads)
HF_TOKEN=

# Kaggle credentials (for API access outside Kaggle runtime)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Google Drive artifact upload (service account JSON path or inline JSON)
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
