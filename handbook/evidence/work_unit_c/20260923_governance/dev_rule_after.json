{
  "id": 20175027,
  "name": "dev_rule",
  "target": "branch",
  "source_type": "Repository",
  "source": "ibn-e-Muhammad/fq-ssiuu",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/dev"
      ]
